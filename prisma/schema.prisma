generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  MEMBER
  ORGANIZER
  ADMIN
}

enum CircleStatus {
  PENDING    // Waiting for members to fill up
  ACTIVE     // Running — payments flowing
  COMPLETED  // All rounds done, everyone got paid
  DISSOLVED  // Cancelled mid-run
}

enum MemberStatus {
  PENDING    // Applied, awaiting organizer approval
  APPROVED   // Approved but circle not yet active
  REJECTED   // Rejected by organizer
  ACTIVE     // Participating in active circle
  DEFAULTED  // Missed payments, flagged
  REMOVED    // Kicked out by organizer/admin
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL    // Paid some, remainder outstanding
  REFUNDED
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerEntryType {
  CONTRIBUTION  // Member pays into pool
  PAYOUT        // Pool pays out to member
  LATE_FEE      // Penalty for late payment
  PLATFORM_FEE  // CircleSave platform cut
  REFUND        // Refund to member
  ADJUSTMENT    // Admin manual adjustment
}

enum DebitStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String

  role         Role    @default(MEMBER)

  trustScore   Float   @default(100)

  isActive     Boolean @default(true)
  isBanned     Boolean @default(false)
  bannedReason String?

  // Profile
  phone        String?
  avatarUrl    String?

  // Relations
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  organizedCircles Circle[]       @relation("OrganizedCircles")
  memberships      CircleMember[]
  payments         Payment[]
  trustEvents      TrustEvent[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// ─────────────────────────────────────────────
// REFRESH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// CIRCLE
// ─────────────────────────────────────────────

model Circle {
  id                 String       @id @default(uuid())
  name               String
  description        String?
  contributionAmount Decimal      @db.Decimal(12, 2)
  currency           String       @default("USD")
  maxMembers         Int
  currentMembers     Int          @default(0)
  frequencyDays      Int          // e.g., 30 = monthly
  status             CircleStatus @default(PENDING)
  inviteCode         String       @unique @default(uuid())

  organizerId        String
  organizer          User         @relation("OrganizedCircles", fields: [organizerId], references: [id])

  startDate          DateTime?
  nextPaymentDate    DateTime?
  currentRound       Int          @default(0)
  totalRounds        Int          @default(0) // set = maxMembers on activate

  // Relations
  members         CircleMember[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  rotationSlots   RotationSlot[]
  scheduledDebits ScheduledDebit[]
  notifications   Notification[]
  swapRequests    SwapRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([inviteCode])
}

// ─────────────────────────────────────────────
// CIRCLE MEMBER
// ─────────────────────────────────────────────

model CircleMember {
  id       String       @id @default(uuid())
  circleId String
  userId   String
  status   MemberStatus @default(PENDING)

  // Rotation position (assigned on circle activation)
  position    Int?    // 1-based, null until activated
  hasReceived Boolean @default(false)
  receivedAt  DateTime?

  // Payment tracking
  totalPaid      Decimal @default(0) @db.Decimal(12, 2)
  missedPayments Int     @default(0)
  latePayments   Int     @default(0)

  // Relations
  circle       Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]
  swapRequests SwapRequest[] @relation("SwapRequester")

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
// ROTATION SLOT  (one per round, tracks who gets paid when)
// ─────────────────────────────────────────────

model RotationSlot {
  id       String  @id @default(uuid())
  circleId String
  round    Int     // which round (1 … N)
  memberId String? // CircleMember.id of the recipient

  isPaid      Boolean  @default(false)
  payoutAmount Decimal? @db.Decimal(12, 2)
  payoutDate  DateTime?
  notes       String?

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([circleId, round])
  @@index([circleId])
}

// ─────────────────────────────────────────────
// SWAP REQUEST  (emergency position swap)
// ─────────────────────────────────────────────

model SwapRequest {
  id                String     @id @default(uuid())
  circleId          String
  requesterId       String     // CircleMember.id of requester
  currentPosition   Int
  requestedPosition Int
  reason            String?
  status            SwapStatus @default(PENDING)

  approvedById String?
  approvedAt   DateTime?

  circle    Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  requester CircleMember @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([requesterId])
  @@index([status])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  circleId      String
  memberId      String        // CircleMember.id
  userId        String        // User.id (denormalized for quick queries)
  round         Int
  dueAmount     Decimal       @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2) // amount actually paid
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  paymentMethod String?

  // Fees
  lateFee     Decimal @default(0) @db.Decimal(12, 2)
  platformFee Decimal @default(0) @db.Decimal(12, 2)

  // Partial payment state machine
  isPartial       Boolean @default(false)
  remainingAmount Decimal @default(0) @db.Decimal(12, 2)

  reference      String?  @db.VarChar(200)
  idempotencyKey String?  @unique
  processedAt    DateTime?
  failureReason  String?

  // Relations
  circle        Circle       @relation(fields: [circleId], references: [id])
  member        CircleMember @relation(fields: [memberId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([memberId])
  @@index([userId])
  @@index([status])
  @@index([round])
}

// ─────────────────────────────────────────────
// LEDGER  (double-entry bookkeeping — IMMUTABLE)
// ─────────────────────────────────────────────

model LedgerEntry {
  id        String          @id @default(uuid())
  circleId  String
  paymentId String?

  type        LedgerEntryType
  description String

  // Double-entry: debitAmount MUST equal creditAmount (enforced in service layer)
  debitAmount  Decimal @db.Decimal(12, 2)
  creditAmount Decimal @db.Decimal(12, 2)
  currency     String  @default("USD")

  // Account names (e.g., "MEMBER_WALLET", "CIRCLE_POOL", "PLATFORM_RESERVE")
  debitAccount  String
  creditAccount String

  // Running balance of the circle pool after this entry
  balanceAfter Decimal @db.Decimal(12, 2)

  // Relations
  circle  Circle   @relation(fields: [circleId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  // NO updatedAt — ledger is append-only and immutable
  createdAt DateTime @default(now())

  @@index([circleId])
  @@index([paymentId])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// SCHEDULED DEBIT  (cron-driven, idempotency-safe)
// ─────────────────────────────────────────────

model ScheduledDebit {
  id            String      @id @default(uuid())
  circleId      String
  memberId      String      // CircleMember.id
  round         Int
  amount        Decimal     @db.Decimal(12, 2)
  scheduledFor  DateTime
  status        DebitStatus @default(SCHEDULED)
  idempotencyKey String     @unique // prevents double-charging

  attemptedAt   DateTime?
  completedAt   DateTime?
  failureReason String?
  retryCount    Int         @default(0)
  nextRetryAt   DateTime?

  circle Circle @relation(fields: [circleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([scheduledFor])
  @@index([status])
}

// ─────────────────────────────────────────────
// TRUST EVENT  (append-only reputation log)
// ─────────────────────────────────────────────

model TrustEvent {
  id         String  @id @default(uuid())
  userId     String
  circleId   String?
  eventType  String  // ON_TIME_PAYMENT | LATE_PAYMENT | DEFAULT | SWAP_GRANTED | CIRCLE_COMPLETED
  delta      Float   // score change (positive or negative)
  scoreAfter Float   // new trust score
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([circleId])
  @@index([eventType])
}

// ─────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────

model Notification {
  id       String  @id @default(uuid())
  userId   String
  circleId String?
  type     String  // PAYMENT_DUE | PAYMENT_RECEIVED | PAYOUT_RELEASED | SWAP_REQUESTED | etc.
  title    String
  body     String
  isRead   Boolean  @default(false)
  readAt   DateTime?
  metadata Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle? @relation(fields: [circleId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([circleId])
}

// ─────────────────────────────────────────────
// IDEMPOTENCY KEY CACHE
// ─────────────────────────────────────────────

model IdempotencyKey {
  id         String   @id @default(uuid())
  key        String   @unique
  userId     String
  response   Json
  statusCode Int
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(uuid())
  userId   String?
  action   String
  entity   String
  entityId String
  ip       String?
  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
}
