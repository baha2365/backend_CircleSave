DATABASE_URL=postgresql://postgres:123@circlesave-db:5432/CircleSave
NODE_ENV=development
PORT=3000
API_VERSION=v1

JWT_ACCESS_SECRET=super_secret_access_key_very_long_123456
JWT_REFRESH_SECRET=super_secret_refresh_key_very_long_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173



# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379



# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# ── Business Rules ────────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=2
LATE_FEE_PERCENT_PER_DAY=0.5
PAYMENT_GRACE_DAYS=5
MAX_CIRCLES_PER_USER=3
DEFAULT_DETECTION_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
